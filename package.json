{
  "name": "mlsm-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rbs/desktop",
    "build": "npm run build --workspace @rbs/desktop",
    "install:mac": "bash scripts/macos/install.sh",
    "install:windows": "scripts\\windows\\install.bat",
    "launch:mac": "bash scripts/macos/launch.sh",
    "launch:windows": "scripts\\windows\\launch.bat",
    "package:mac": "bash scripts/macos/build.sh",
    "package:windows": "scripts\\windows\\build.bat",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "setup:runtimes": "node tools/setup_python_runtime.cjs upscaler && node tools/setup_python_runtime.cjs ai-quantizer && node tools/setup_python_runtime.cjs song-player && node tools/setup_python_runtime.cjs audio-tts",
    "install:verify": "node tools/verify_installation.cjs",
    "upscaler:setup": "node tools/setup_python_runtime.cjs upscaler",
    "upscaler:server": "node tools/run_python_service.cjs upscaler",
    "rife:verify": "node tools/verify_rife_runtime.cjs",
    "song-player:setup": "node tools/setup_python_runtime.cjs song-player",
    "song-player:worker": "node tools/song-player/run_worker.cjs",
    "audio-tts:setup": "node tools/setup_python_runtime.cjs audio-tts",
    "ai-quantizer:setup": "node tools/setup_python_runtime.cjs ai-quantizer",
    "ai-quantizer:server": "node tools/run_python_service.cjs ai-quantizer"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
