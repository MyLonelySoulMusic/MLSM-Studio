{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamicsound.studio/schema/project/v1.json",
  "title": "MLSM Studio Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "audio", "canvas", "analysis", "events", "ball", "objects", "trajectorySegments", "camera", "background", "lighting", "postProcessing", "exportPresets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "$ref": "#/$defs/projectMetadata" },
    "audio": { "$ref": "#/$defs/audio" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/musicEvent" } },
    "animation": { "type": "object", "additionalProperties": true, "required": ["modeId", "baseObjectTypes"], "properties": { "modeId": { "type": "string", "minLength": 1 }, "baseObjectTypes": { "type": "array", "minItems": 1, "items": { "enum": ["drum", "kick", "snare", "cymbal", "piano", "guitar", "strings", "peg", "platform", "block", "spring", "pebble"] } }, "newYorkStreets": { "type": "object", "additionalProperties": true }, "portraitLandscape": { "$ref": "#/$defs/portraitLandscape" }, "commentsInvasion": { "$ref": "#/$defs/commentsInvasion" }, "backgroundAuto": { "$ref": "#/$defs/backgroundAuto" }, "upscaler": { "$ref": "#/$defs/upscaler" }, "frameBooster": { "$ref": "#/$defs/frameBooster" }, "songPlayer": { "$ref": "#/$defs/songPlayer" }, "cassetteDesk": { "$ref": "#/$defs/cassetteDesk" }, "overlaySpectral": { "$ref": "#/$defs/overlaySpectral" } } },
    "ball": { "$ref": "#/$defs/ball" },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/sceneObject" } },
    "trajectorySegments": { "type": "array", "items": { "$ref": "#/$defs/trajectorySegment" } },
    "camera": { "$ref": "#/$defs/camera" },
    "background": { "$ref": "#/$defs/background" },
    "lighting": { "type": "object" },
    "postProcessing": { "type": "object" },
    "exportPresets": { "type": "array", "items": { "$ref": "#/$defs/exportPreset" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "vector3": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "transform": {
      "type": "object", "additionalProperties": false, "required": ["position", "rotation", "scale"],
      "properties": { "position": { "$ref": "#/$defs/vector3" }, "rotation": { "$ref": "#/$defs/vector3" }, "scale": { "$ref": "#/$defs/vector3" } }
    },
    "fps": {
      "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"],
      "properties": { "numerator": { "type": "integer", "minimum": 1, "maximum": 120000 }, "denominator": { "type": "integer", "minimum": 1, "maximum": 1001 } }
    },
    "projectMetadata": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "createdAt", "updatedAt", "seed"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "name": { "$ref": "#/$defs/nonEmptyString" },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "storage", "hash", "durationSeconds", "sampleRate", "channels", "globalOffsetMs"],
      "properties": {
        "sourcePath": { "type": "string" }, "storage": { "enum": ["project", "external"] },
        "hash": { "type": "string", "pattern": "^(?:|[a-fA-F0-9]{64})$" }, "durationSeconds": { "type": "number", "minimum": 0 },
        "sampleRate": { "type": "integer", "minimum": 1 }, "channels": { "type": "integer", "minimum": 1 },
        "globalOffsetMs": { "type": "number", "minimum": -250, "maximum": 250 }
      }
    },
    "canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["aspectRatio", "previewWidth", "previewHeight", "previewFps", "exportWidth", "exportHeight", "exportFps"],
      "properties": {
        "aspectRatio": { "enum": ["9:16", "16:9", "1:1", "4:5", "custom"] },
        "previewWidth": { "type": "integer", "minimum": 64, "maximum": 7680 }, "previewHeight": { "type": "integer", "minimum": 64, "maximum": 7680 },
        "previewFps": { "$ref": "#/$defs/fps" }, "exportWidth": { "type": "integer", "minimum": 64, "maximum": 7680 },
        "exportHeight": { "type": "integer", "minimum": 64, "maximum": 7680 }, "exportFps": { "$ref": "#/$defs/fps" }
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["analyzerVersion", "cacheKey", "globalBpm", "latencyCompensationMs", "waveform"],
      "properties": {
        "analyzerVersion": { "type": "string" }, "cacheKey": { "type": "string" },
        "globalBpm": { "type": ["number", "null"], "exclusiveMinimum": 0 }, "latencyCompensationMs": { "type": "number" },
        "waveform": { "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 } },
        "localTempo": { "type": "array", "items": { "type": "object" } }, "segments": { "type": "array", "items": { "type": "object" } }
      }
    },
    "musicEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "timeSeconds", "timeSamples", "eventType", "confidence", "strength", "frequencyBand", "assignedObjectType", "enabled", "accent", "manualOverride", "expectedBallPosition", "expectedBallVelocity", "expectedImpactNormal"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "timeSeconds": { "type": "number", "minimum": 0 }, "timeSamples": { "type": "integer", "minimum": 0 },
        "eventType": { "enum": ["beat", "downbeat", "onset", "kick", "snare", "hihat", "piano", "guitar", "strings", "percussion", "manual", "custom"] },
        "confidence": { "$ref": "#/$defs/unit" }, "strength": { "$ref": "#/$defs/unit" },
        "frequencyBand": { "enum": ["low", "mid", "high", "full"] },
        "assignedObjectType": { "type": ["string", "null"] }, "assignedObjectId": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" }, "accent": { "type": "boolean" }, "manualOverride": { "type": "boolean" },
        "action": { "enum": ["none", "collision", "accentedCollision", "nearMiss", "freeFall", "camera", "light", "color", "particles", "background", "custom"] },
        "expectedBallPosition": { "$ref": "#/$defs/vector3" }, "expectedBallVelocity": { "$ref": "#/$defs/vector3" }, "expectedImpactNormal": { "$ref": "#/$defs/vector3" }
      }
    },
    "material": {
      "type": "object", "additionalProperties": false, "required": ["color", "roughness", "metalness", "emission", "opacity"],
      "properties": { "color": { "type": "string" }, "palette": { "type": "array", "items": { "type": "string" } }, "roughness": { "$ref": "#/$defs/unit" }, "metalness": { "$ref": "#/$defs/unit" }, "emission": { "type": "number", "minimum": 0 }, "opacity": { "$ref": "#/$defs/unit" }, "textureAssetId": { "type": ["string", "null"] } }
    },
    "ball": {
      "type": "object", "additionalProperties": false, "required": ["radius", "visualMass", "material", "spinRate", "impactDeformation", "trailEnabled"],
      "properties": { "radius": { "type": "number", "exclusiveMinimum": 0 }, "visualMass": { "type": "number", "exclusiveMinimum": 0 }, "material": { "$ref": "#/$defs/material" }, "spinRate": { "type": "number" }, "impactDeformation": { "$ref": "#/$defs/unit" }, "trailEnabled": { "type": "boolean" }, "innerColor": { "type": "string" }, "innerShape": { "enum": ["orb", "icosahedron", "torusKnot"] }, "innerImageUrl": { "type": ["string", "null"] }, "endRevealEnabled": { "type": "boolean" }, "revealMode": { "enum": ["end", "time"] }, "revealTimeSeconds": { "type": "number", "minimum": 0 }, "revealHoldSeconds": { "type": "number", "minimum": 0, "maximum": 30 } }
    },
    "sceneObject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type", "transform", "material", "restitution", "friction", "visible", "locked", "castShadow", "receiveShadow"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["drum", "snare", "tom", "kick", "cymbal", "piano", "guitar", "strings", "pebble", "triangle", "block", "peg", "platform", "inclinedPlatform", "spring", "trampoline", "bell", "rope", "tube", "ring", "blade", "crystal", "key", "electronicPad", "custom"] },
        "railType": { "enum": ["pinball", "glassTube", "bricks"] },
        "transform": { "$ref": "#/$defs/transform" }, "material": { "$ref": "#/$defs/material" },
        "restitution": { "$ref": "#/$defs/unit" }, "friction": { "$ref": "#/$defs/unit" }, "visible": { "type": "boolean" }, "locked": { "type": "boolean" },
        "castShadow": { "type": "boolean" }, "receiveShadow": { "type": "boolean" }, "assetId": { "type": ["string", "null"] }
      }
    },
    "trajectorySegment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "startEventId", "endEventId", "startTime", "endTime", "startPosition", "endPosition", "initialVelocity", "gravity", "assisted", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "startEventId": { "$ref": "#/$defs/nonEmptyString" }, "endEventId": { "$ref": "#/$defs/nonEmptyString" },
        "startTime": { "type": "number", "minimum": 0 }, "endTime": { "type": "number", "exclusiveMinimum": 0 },
        "startPosition": { "$ref": "#/$defs/vector3" }, "endPosition": { "$ref": "#/$defs/vector3" }, "initialVelocity": { "$ref": "#/$defs/vector3" }, "gravity": { "$ref": "#/$defs/vector3" },
        "assisted": { "type": "boolean" }, "motionKind": { "enum": ["bounce", "slide", "roll", "freeFall", "sewerDrop"] }, "assistanceKind": { "enum": ["none", "objectPosition", "localGravity", "impulseObject", "invisibleGuide", "spatialScale"] },
        "status": { "enum": ["valid", "invalid"] }, "diagnostic": { "type": "string" }
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false, "required": ["mode", "position", "target", "fieldOfView", "damping", "lookAhead"],
      "properties": { "mode": { "enum": ["fixed", "verticalTracking", "fullTracking", "smoothFollow", "cinematic", "keyframed", "autoFraming", "spline"] }, "position": { "$ref": "#/$defs/vector3" }, "target": { "$ref": "#/$defs/vector3" }, "fieldOfView": { "type": "number", "exclusiveMinimum": 0, "maximum": 179 }, "damping": { "$ref": "#/$defs/unit" }, "lookAhead": { "type": "number", "minimum": 0 } }
    },
    "background": {
      "type": "object", "additionalProperties": false, "required": ["type", "colors", "opacity", "blur", "brightness", "contrast", "saturation"],
      "properties": { "type": { "enum": ["solid", "linearGradient", "radialGradient", "image", "video", "texture", "wall", "abstract", "transparent"] }, "colors": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "assetId": { "type": ["string", "null"] }, "imageUrl": { "type": ["string", "null"] }, "presetId": { "type": "string" }, "finish": { "enum": ["clean", "worn"] }, "opacity": { "$ref": "#/$defs/unit" }, "blur": { "type": "number", "minimum": 0 }, "brightness": { "type": "number", "minimum": 0 }, "contrast": { "type": "number", "minimum": 0 }, "saturation": { "type": "number", "minimum": 0 }, "effects": { "type": "object", "additionalProperties": false, "properties": { "glow": { "type": "boolean" }, "particles": { "type": "boolean" }, "vignette": { "type": "boolean" } }, "required": ["glow", "particles", "vignette"] }, "neon": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "text": { "type": "string", "maxLength": 1000 }, "color": { "type": "string" } }, "required": ["enabled", "text", "color"] }, "railColors": { "type": "object", "additionalProperties": false, "properties": { "pinball": { "type": "string" }, "glassTube": { "type": "string" }, "bricks": { "type": "string" } }, "required": ["pinball", "glassTube", "bricks"] } }
    },
    "portraitLandscape": {
      "type": "object", "additionalProperties": false,
      "required": ["videoUrl", "videoName", "videoWidth", "videoHeight", "videoHasAudio", "sideImageUrl", "sideImagePlacement", "coverImageUrl", "palette", "autoPalette", "spectrumIntensity", "spectrumOpacity", "cubeScale", "cubeSpeed", "glassOpacity", "effects", "effectLayers", "effectColors", "effectOpacity", "layerOrder", "sideImageAdjustments", "effectIntensity"],
      "properties": {
        "videoUrl": { "type": ["string", "null"] }, "videoName": { "type": "string" }, "videoWidth": { "type": "integer", "minimum": 0 }, "videoHeight": { "type": "integer", "minimum": 0 }, "videoHasAudio": { "type": "boolean" },
        "sideImageUrl": { "type": ["string", "null"] }, "sideImagePlacement": { "enum": ["left", "right"] }, "coverImageUrl": { "type": ["string", "null"] },
        "palette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "sideImagePalette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "spectrumManualPalette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "autoPalette": { "type": "boolean" }, "spectrumPaletteSource": { "enum": ["cover", "sideImage", "manual"] },
        "spectrumIntensity": { "type": "number", "minimum": 0, "maximum": 3 }, "spectrumOpacity": { "$ref": "#/$defs/unit" }, "cubeScale": { "type": "number", "minimum": 0.4, "maximum": 2 }, "cubeSpeed": { "type": "number", "minimum": 0.1, "maximum": 2 }, "cubeRotationBeats": { "type": "integer", "minimum": 4, "maximum": 32 }, "cubeRotationSpeed": { "type": "number", "minimum": 0.25, "maximum": 2.5 }, "glassOpacity": { "$ref": "#/$defs/unit" },
        "effects": { "type": "object", "additionalProperties": false, "required": ["rain", "lightning", "feathers", "particles"], "properties": { "rain": { "type": "boolean" }, "lightning": { "type": "boolean" }, "feathers": { "type": "boolean" }, "particles": { "type": "boolean" } } },
        "effectLayers": { "type": "object", "additionalProperties": false, "required": ["rain", "lightning", "feathers", "particles"], "properties": { "rain": { "enum": ["behindCube", "behindVideo", "behindSpectrum", "foreground"] }, "lightning": { "enum": ["behindCube", "behindVideo", "behindSpectrum", "foreground"] }, "feathers": { "enum": ["behindCube", "behindVideo", "behindSpectrum", "foreground"] }, "particles": { "enum": ["behindCube", "behindVideo", "behindSpectrum", "foreground"] } } },
        "effectColors": { "type": "object", "additionalProperties": false, "required": ["rain", "lightning", "feathers", "particles"], "properties": { "rain": { "type": "string" }, "lightning": { "type": "string" }, "feathers": { "type": "string" }, "particles": { "type": "string" } } },
        "effectOpacity": { "type": "object", "additionalProperties": false, "required": ["rain", "lightning", "feathers", "particles"], "properties": { "rain": { "$ref": "#/$defs/unit" }, "lightning": { "$ref": "#/$defs/unit" }, "feathers": { "$ref": "#/$defs/unit" }, "particles": { "$ref": "#/$defs/unit" } } },
        "layerOrder": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["sideImage", "cube", "centerVideo", "spectrum", "rain", "lightning", "feathers", "particles"] } },
        "sideImageAdjustments": { "type": "object", "additionalProperties": false, "required": ["brightness", "exposure", "contrast", "saturation", "temperature", "blur"], "properties": { "brightness": { "type": "number", "minimum": 0.2, "maximum": 2 }, "exposure": { "type": "number", "minimum": -1, "maximum": 1 }, "contrast": { "type": "number", "minimum": 0.2, "maximum": 2 }, "saturation": { "type": "number", "minimum": 0, "maximum": 2.5 }, "temperature": { "type": "number", "minimum": -1, "maximum": 1 }, "blur": { "type": "number", "minimum": 0, "maximum": 12 } } },
        "effectIntensity": { "type": "number", "minimum": 0, "maximum": 3 }
      }
    },
    "backgroundAuto": {
      "type": "object", "additionalProperties": false,
      "required": ["imageUrl", "sourceWidth", "sourceHeight", "palette", "detectionThreshold", "detections", "effects", "personAnimationEnabled"],
      "properties": {
        "imageUrl": { "type": ["string", "null"] }, "sourceWidth": { "type": "integer", "minimum": 0 }, "sourceHeight": { "type": "integer", "minimum": 0 },
        "palette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "detectionThreshold": { "type": "number", "minimum": 0.05, "maximum": 0.9 },
        "detections": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/backgroundAutoDetection" } },
        "effects": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/backgroundAutoEffect" } },
        "personAnimationEnabled": { "type": "boolean" }
      }
    },
    "backgroundAutoDetection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "score", "bbox", "isPerson", "paletteMode", "palette"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "label": { "$ref": "#/$defs/nonEmptyString" }, "alias": { "type": "string", "maxLength": 120 }, "score": { "$ref": "#/$defs/unit" }, "isPerson": { "type": "boolean" }, "paletteMode": { "enum": ["auto", "manual"] }, "palette": { "type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "bbox": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "$ref": "#/$defs/unit" }, "y": { "$ref": "#/$defs/unit" }, "width": { "$ref": "#/$defs/unit" }, "height": { "$ref": "#/$defs/unit" } } }
      }
    },
    "backgroundAutoEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "label", "enabled", "detectionId", "paletteMode", "color", "palette", "intensity", "scale", "opacity", "collisionParticles", "rotationSpeed"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "type": { "const": "circularSpectrum" }, "label": { "const": "Circular Spectrum" }, "enabled": { "type": "boolean" }, "color": { "type": "string" },
        "placementMode": { "enum": ["detected", "manual"] }, "detectionId": { "type": ["string", "null"], "minLength": 1 }, "centerX": { "$ref": "#/$defs/unit" }, "centerY": { "$ref": "#/$defs/unit" }, "diameter": { "type": "number", "minimum": 0.05, "maximum": 1 }, "paletteMode": { "enum": ["auto", "manual"] },
        "palette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "intensity": { "type": "number", "minimum": 0, "maximum": 3 }, "scale": { "type": "number", "minimum": 0.25, "maximum": 3 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "collisionParticles": { "type": "boolean" }, "centerSpectrumEnabled": { "type": "boolean" }, "stereoSidesEnabled": { "type": "boolean" }, "subtitlesEnabled": { "type": "boolean" }, "radialSpectrumEnabled": { "type": "boolean" }, "rotationSpeed": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "upscaler": {
      "type": "object", "additionalProperties": true,
      "properties": { "remote": { "$ref": "#/$defs/upscalerRemote" } }
    },
    "upscalerRemote": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "endpoints", "model", "frameRetries", "segmentFrames", "outputFps"],
      "properties": {
        "enabled": { "type": "boolean" }, "model": { "type": "string", "maxLength": 200 },
        "frameRetries": { "type": "integer", "minimum": 0, "maximum": 6 },
        "segmentFrames": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "outputFps": { "type": ["number", "null"], "minimum": 1, "maximum": 480 },
        "endpoints": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/upscalerRemoteEndpoint" } }
      }
    },
    "upscalerRemoteEndpoint": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "url", "enabled"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "label": { "type": "string", "maxLength": 100 }, "url": { "type": "string", "format": "uri", "maxLength": 2048 }, "enabled": { "type": "boolean" } }
    },
    "commentsInvasion": {
      "type": "object", "additionalProperties": false,
      "required": ["videoUrl", "videoName", "videoWidth", "videoHeight", "videoHasAudio", "maxVisible", "commentScale", "intervalSeconds", "initialDelaySeconds", "impactDurationSeconds", "impactIntensity", "rotationDegrees", "holdDurationSeconds", "exitDurationSeconds", "exitAnimation", "videoFit", "backgroundColor", "safeArea"],
      "properties": {
        "videoUrl": { "type": ["string", "null"] }, "videoName": { "type": "string", "maxLength": 500 },
        "videoWidth": { "type": "integer", "minimum": 0 }, "videoHeight": { "type": "integer", "minimum": 0 }, "videoHasAudio": { "type": "boolean" },
        "maxVisible": { "type": "integer", "minimum": 1, "maximum": 20 }, "commentScale": { "type": "number", "minimum": 0.1, "maximum": 0.8 },
        "intervalSeconds": { "type": "number", "minimum": 0.15, "maximum": 30 }, "initialDelaySeconds": { "type": "number", "minimum": 0, "maximum": 60 },
        "impactDurationSeconds": { "type": "number", "minimum": 0.08, "maximum": 2 }, "impactIntensity": { "type": "number", "minimum": 0.25, "maximum": 2 },
        "holdDurationSeconds": { "type": "number", "minimum": 0.25, "maximum": 30 }, "exitDurationSeconds": { "type": "number", "minimum": 0.08, "maximum": 3 },
        "exitAnimation": { "enum": ["fade", "shrink", "slide-up", "slide-side", "spin"] },
        "rotationDegrees": { "type": "number", "minimum": 0, "maximum": 20 }, "videoFit": { "enum": ["contain", "cover"] },
        "backgroundColor": { "type": "string" }, "safeArea": { "type": "number", "minimum": 0, "maximum": 0.15 }
      }
    },
    "frameBooster": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sourceUrl": { "type": ["string", "null"] }, "sourceName": { "type": "string", "maxLength": 500 }, "sourceWidth": { "type": "integer", "minimum": 0 }, "sourceHeight": { "type": "integer", "minimum": 0 }, "sourceDurationSeconds": { "type": "number", "minimum": 0 }, "sourceFps": { "type": ["number", "null"], "exclusiveMinimum": 0 }, "sourceFrameCount": { "type": ["integer", "null"], "minimum": 0 }, "sourceHasAudio": { "type": "boolean" },
        "method": { "enum": ["motion", "motion-obmc", "blend"] }, "targetMode": { "enum": ["multiplier", "fps"] }, "targetMultiplier": { "enum": [2, 3, 4, 5] }, "targetFps": { "type": "number", "exclusiveMinimum": 0, "maximum": 480 }, "scale": { "enum": [0.5, 1, 2] }, "sceneCut": { "type": "boolean" }, "quality": { "enum": ["balanced", "high"] }, "lastOutput": { "type": ["object", "null"] }
      }
    },
    "cassetteDesk": {
      "type": "object", "additionalProperties": false,
      "required": ["coverImageUrl", "title", "artist", "stereoStyle", "windowEnvironment", "autoPalette", "palette", "waveformColorMode", "waveformColor", "displaySpectrumColorMode", "displaySpectrumColor", "stereoBodyColorMode", "stereoBodyColor", "pianoColorMode", "pianoColor", "deskColorMode", "deskColor", "introDurationSeconds", "vocalToleranceCents", "tempoDetectionMode", "manualBpm", "halfTime", "keyDetectionMode", "manualKeyRoot", "manualKeyMode", "showWaveform", "showPiano", "showTrackInfo"],
      "properties": {
        "coverImageUrl": { "type": ["string", "null"], "not": { "type": "string", "pattern": "^blob:" } }, "title": { "type": "string", "maxLength": 160 }, "artist": { "type": "string", "maxLength": 160 }, "stereoStyle": { "enum": ["classic", "poster"] }, "windowEnvironment": { "enum": ["summer-day", "snow-day", "night", "rain-night", "starry-moon", "pink-moon", "pink-meteor"] }, "autoPalette": { "type": "boolean" },
        "palette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "waveformColorMode": { "enum": ["auto", "manual"] }, "waveformColor": { "type": "string" }, "displaySpectrumColorMode": { "enum": ["auto", "manual"] }, "displaySpectrumColor": { "type": "string" }, "stereoBodyColorMode": { "enum": ["auto", "manual"] }, "stereoBodyColor": { "type": "string" }, "pianoColorMode": { "enum": ["auto", "manual"] }, "pianoColor": { "type": "string" }, "deskColorMode": { "enum": ["auto", "manual"] }, "deskColor": { "type": "string" },
        "introDurationSeconds": { "type": "number", "minimum": 3.6, "maximum": 8 }, "vocalToleranceCents": { "type": "number", "minimum": 10, "maximum": 100 }, "tempoDetectionMode": { "enum": ["auto", "manual"] }, "manualBpm": { "type": "number", "minimum": 20, "maximum": 300 }, "halfTime": { "type": "boolean" }, "keyDetectionMode": { "enum": ["auto", "manual"] }, "manualKeyRoot": { "type": "integer", "minimum": 0, "maximum": 11 }, "manualKeyMode": { "enum": ["major", "minor"] }, "showWaveform": { "type": "boolean" }, "showPiano": { "type": "boolean" }, "showTrackInfo": { "type": "boolean" }
      }
    },
    "overlaySpectral": {
      "type": "object", "additionalProperties": false,
      "required": ["backgroundImageUrl", "backgroundMediaType", "backgroundFit", "backgroundDim", "title", "artist", "showMetadata", "visualStyle", "presetId", "autoPalette", "palette", "paletteInfluence", "intensity", "sensitivity", "overlayOpacity", "motionSpeed", "symmetry", "trail", "blendMode"],
      "properties": {
        "backgroundImageUrl": { "type": ["string", "null"], "not": { "type": "string", "pattern": "^blob:" } }, "backgroundMediaType": { "enum": ["image", "video"] }, "backgroundFit": { "enum": ["cover", "contain"] }, "backgroundDim": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "type": "string", "maxLength": 160 }, "artist": { "type": "string", "maxLength": 160 }, "showMetadata": { "type": "boolean" }, "visualStyle": { "enum": ["radial", "tunnel", "kaleidoscope", "plasma"] }, "presetId": { "enum": ["milkdrop-radial-spectrum", "milkdrop-spectral-tunnel", "milkdrop-kaleidoscope", "milkdrop-plasma-field", "milkdrop-spectrum-bars", "milkdrop-circular-spectrum", "milkdrop-waveform-line", "milkdrop-particle-burst", "milkdrop-pulse-shapes", "milkdrop-dynamic-vignette", "milkdrop-radial-rays", "milkdrop-mirrored-waveform", "milkdrop-audio-grid", "milkdrop-orbiting-particles"] },
        "autoPalette": { "type": "boolean" }, "palette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "paletteInfluence": { "type": "number", "minimum": 0, "maximum": 1 }, "intensity": { "type": "number", "minimum": 0.1, "maximum": 3 }, "sensitivity": { "type": "number", "minimum": 0.25, "maximum": 3 },
        "overlayOpacity": { "type": "number", "minimum": 0.1, "maximum": 1 }, "motionSpeed": { "type": "number", "minimum": 0, "maximum": 3 }, "symmetry": { "enum": [4, 6, 8, 12] }, "trail": { "type": "number", "minimum": 0, "maximum": 0.95 }, "blendMode": { "enum": ["screen", "lighter", "source-over"] }
      }
    },
    "songPlayer": {
      "$comment": "Canonical persisted Song Player output. The TypeScript parser remains the migration authority and supplies these defaults for legacy projects.",
      "type": "object", "additionalProperties": false, "required": ["assets", "fullTrackAssetId", "coverImageUrl", "backgroundImageUrl", "backgroundFit", "title", "artist", "coverStyle", "autoPalette", "palette", "spectrumPaletteMode", "spectrumPalette", "spectrogramPaletteMode", "spectrogramPalette", "spectrumGain", "spectrogramOpacity", "metadataVisible", "match"],
      "properties": {
        "assets": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/songPlayerAsset" } },
        "fullTrackAssetId": { "type": ["string", "null"], "minLength": 1 },
        "coverImageUrl": { "type": ["string", "null"], "not": { "type": "string", "pattern": "^blob:" } }, "backgroundImageUrl": { "type": ["string", "null"], "not": { "type": "string", "pattern": "^blob:" } }, "backgroundFit": { "enum": ["cover", "contain"] },
        "title": { "type": "string", "maxLength": 160 }, "artist": { "type": "string", "maxLength": 160 }, "coverStyle": { "enum": ["flat", "cube"] }, "autoPalette": { "type": "boolean" },
        "palette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "spectrumPaletteMode": { "enum": ["auto", "manual"] }, "spectrumPalette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "spectrogramPaletteMode": { "enum": ["auto", "manual"] }, "spectrogramPalette": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "spectrumGain": { "type": "number", "minimum": 0, "maximum": 3 }, "spectrogramOpacity": { "type": "number", "minimum": 0, "maximum": 1 }, "metadataVisible": { "type": "boolean" }, "match": { "$ref": "#/$defs/songPlayerMatch" }
      }
    },
    "songPlayerAsset": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "source", "sourcePath", "fileName", "mimeType", "hash", "durationSeconds", "sampleRate", "channels", "fileSize", "provider"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "const": "fullTrack" }, "source": { "enum": ["localImport", "youtubeDownload"] }, "sourcePath": { "$ref": "#/$defs/nonEmptyString" }, "fileName": { "$ref": "#/$defs/nonEmptyString" }, "mimeType": { "$ref": "#/$defs/nonEmptyString" }, "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }, "sampleRate": { "type": "integer", "minimum": 1 }, "channels": { "type": "integer", "minimum": 1 }, "fileSize": { "type": "integer", "minimum": 1 }, "provider": { "type": "object", "additionalProperties": false, "required": ["sourceUrl", "videoId", "title"], "properties": { "sourceUrl": { "type": ["string", "null"], "format": "uri" }, "videoId": { "type": ["string", "null"], "minLength": 1 }, "title": { "type": ["string", "null"], "minLength": 1 } } } }
    },
    "songPlayerMatch": {
      "type": "object", "additionalProperties": false, "required": ["state", "fragmentHash", "fullTrackHash", "selectedOffsetMs", "confidence", "candidates", "resolution", "error", "analyzedAt"],
      "properties": { "state": { "enum": ["idle", "running", "matched", "ambiguous", "manual", "failed"] }, "fragmentHash": { "type": "string", "pattern": "^(?:|[a-fA-F0-9]{64})$" }, "fullTrackHash": { "type": "string", "pattern": "^(?:|[a-fA-F0-9]{64})$" }, "selectedOffsetMs": { "type": "integer", "minimum": 0, "maximum": 7200000 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "candidates": { "type": "array", "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["offsetMs", "score"], "properties": { "offsetMs": { "type": "integer", "minimum": 0, "maximum": 7200000 }, "score": { "type": "number", "minimum": 0, "maximum": 1 } } } }, "resolution": { "enum": ["auto", "manual"] }, "error": { "type": ["string", "null"], "maxLength": 500 }, "analyzedAt": { "type": ["string", "null"], "format": "date-time" } }
    },
    "exportPreset": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "format", "codec", "width", "height", "fps", "audioMode"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "name": { "$ref": "#/$defs/nonEmptyString" }, "format": { "enum": ["mp4", "mov", "webm", "pngSequence"] }, "codec": { "enum": ["h264", "h265", "prores422", "prores4444", "vp9", "av1", "png"] }, "width": { "type": "integer", "minimum": 64, "maximum": 7680 }, "height": { "type": "integer", "minimum": 64, "maximum": 7680 }, "fps": { "$ref": "#/$defs/fps" }, "audioMode": { "enum": ["copy", "aac", "pcm", "none"] }, "crf": { "type": ["number", "null"] }, "bitrateKbps": { "type": ["integer", "null"], "minimum": 1 } }
    }
  }
