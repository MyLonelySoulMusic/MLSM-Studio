node_modules/
.env
.env.*
!.env.example
.mlsm-settings/
.venv-audio-tts/
coverage/
**/dist/
**/target/
.DS_Store
*.log
*.partial

# Cache incrementale TypeScript generata localmente da tsc.
# Non è uno stato di release e non deve essere condivisa tra Mac e Windows.
*.tsbuildinfo

# Launcher con logo generati localmente: contengono percorsi specifici della macchina.
/scripts/macos/MLSM Studio.app/
/scripts/windows/MLSM Studio.lnk

# File di sessione effimeri creati da database aperti con `:memory:`.
# Il carattere `:` rende questi percorsi impossibili da estrarre su Windows/NTFS.
/:memory:*.ses

# I pesi Whisper/LLM non fanno parte del repository né della build.
# Transformers.js li scarica al primo utilizzo e li conserva nella cache locale.
apps/desktop/public/models/
.transformers-cache/
**/.cache/huggingface/
*.onnx
*.onnx_data
*.safetensors
*.gguf

# Pesi e runtime dell'Upscaler: cache locale al primo utilizzo, mai nel repository.
.upscaler-cache/
apps/desktop/public/upscaler-models/
**/realesrgan-models/
*.pth
*.param
.venv/
.venv-upscaler/
.venv-ai-quantizer/
.venv-song-player/
.venv-avatar3d/
.avatar3d-runtime/
__pycache__/
*.py[cod]

# Runtime, progetti audio e modelli locali di Music / AI Quantizer.
.ai-quantizer-data/
tools/ai-quantizer/data/
tools/ai-quantizer/models/

# Fotogrammi e risultati intermedi generati localmente dai job video.
temp/

# Database, metadati e cache locali di Memory: mai nel repository.
/.mlsm-memory/

# Stato AutoPost locale: blog, coda, libreria, statistiche e chiave cifrata.
/.mlsm-autopost/

# Riferimenti social locali dell'artista (contenuto non versionato)
/social.md

# Asset personali conservati localmente: non versionare foto, mesh o texture.
# Queste regole sono intenzionalmente per namespace espliciti; non ignorare i
# modelli generici già presenti nel repository (per esempio mixamo/*.fbx).
/.avatar3d-private/
/img/avatar/
/img/avatar-*
/apps/desktop/public/.avatar3d-private/
/apps/desktop/public/avatar3d-models/
